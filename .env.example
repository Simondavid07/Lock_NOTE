# Locknote environment configuration
# Copy this file to `.env` for local API development. Never commit real values.

# -----------------------------------------------------------------------------
# Server-only Supabase credentials
# -----------------------------------------------------------------------------
# Project URL, for example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Server-side secret. It writes encrypted records, storage objects, and audit
# events. Never expose this value to the browser or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Browser-safe Supabase configuration
# -----------------------------------------------------------------------------
# These values are embedded into the Vite build and are safe for browser use.
# Use the project URL and publishable/anon key from Supabase Connect settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave empty when the Vite frontend and API are deployed together on Vercel.
# Set this only when the frontend calls a separately hosted API.
VITE_API_BASE=

# -----------------------------------------------------------------------------
# Local API settings
# -----------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API during development.
# Add the production Vercel URL if you host the API separately.
CORS_ORIGINS=http://localhost:5173
PORT=3001

# Vercel invokes the daily cleanup function with this Bearer token.
# Use a long random value in Vercel Project Settings; it is server-only.
CRON_SECRET=

# GitHub OAuth is configured inside Supabase Authentication > Providers.
# Do not add a GitHub OAuth client secret to this file or to Vercel.
